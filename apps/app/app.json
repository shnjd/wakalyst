{
  "expo": {
    "name": "Wakalyst",
    "slug": "wakalyst",
    "version": "1.0.0",
    "scheme": "wakalyst",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.shinjith.wakalyst"
    },
    "android": {
      "package": "dev.shinjith.wakalyst",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      "expo-image"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fa275d03-5e8f-4f61-a0ef-5f92f0b0fd57"
      }
    },
    "owner": "shnjds-team"
  }
}
