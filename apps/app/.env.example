# URL of the auth Worker. `pnpm --filter @wakalyst/worker dev` serves it on :8787.
# On a phone or Android emulator, use your machine's LAN address instead of localhost.
EXPO_PUBLIC_AUTH_URL=http://localhost:8787
# "/" means the site serving the app: used by `pnpm build:hosted`, the web
# build the Worker itself serves. Native builds need a full URL.
